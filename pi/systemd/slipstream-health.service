[Unit]
Description=Slipstream control service (health, stills, modes)
After=network-online.target slipstream-mediamtx.service
Wants=network-online.target

[Service]
User=william
StateDirectory=slipstream
ExecStart=/usr/bin/python3 /home/william/slipstream/pi/health.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
