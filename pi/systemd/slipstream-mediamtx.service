[Unit]
Description=Slipstream camera stream (MediaMTX)
After=network-online.target
Wants=network-online.target

[Service]
User=william
StateDirectory=slipstream
WorkingDirectory=/var/lib/slipstream
ExecStart=/usr/local/bin/mediamtx /etc/slipstream/mediamtx.yml
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
